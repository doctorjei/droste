@quiet seed.checks
@quiet fiber.checks
@quiet sheet.checks
@quiet page.checks
@quiet tome.checks

# Compilers
gcc available	command -v gcc
g++ available	command -v g++
make available	command -v make

# Build systems
cmake available	command -v cmake
autoconf available	command -v autoconf
automake available	command -v automake
pkg-config available	command -v pkg-config
ninja available	command -v ninja

# Debugging
gdb available	command -v gdb
valgrind available	command -v valgrind

# Utilities
ccache available	command -v ccache
bear available	command -v bear
libtoolize available	command -v libtoolize

# Kernel/initramfs build
bison available	command -v bison
flex available	command -v flex
libelf-dev installed	dpkg -s libelf-dev 2>/dev/null | grep -q '^Status: install ok installed$'
libssl-dev installed	dpkg -s libssl-dev 2>/dev/null | grep -q '^Status: install ok installed$'
libncurses-dev installed	dpkg -s libncurses-dev 2>/dev/null | grep -q '^Status: install ok installed$'
cpio available	command -v cpio
busybox-static available	dpkg -s busybox-static 2>/dev/null | grep -q "^Status: install ok installed$"

# Shell linting
shellcheck available	command -v shellcheck

# Python dev toolchain
black available	black --version
isort available	isort --version
ruff available	ruff --version
mypy available	mypy --version
pre-commit available	pre-commit --version
twine available	twine --version
bump-my-version available	bump-my-version --version
python3-build available	pyproject-build --version

# Additional utilities
pdftotext available	command -v pdftotext
git-lfs available	git-lfs --version
bat available	batcat --version
bat symlink	test -L /usr/local/bin/bat
git-delta available	delta --version
