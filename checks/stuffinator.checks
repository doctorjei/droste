@quiet seed.checks
@quiet lint.checks
@quiet fiber.checks
@quiet thread.checks
@quiet sheet.checks
@quiet yarn.checks
@quiet page.checks
@quiet fabric.checks
@quiet tome.checks
@quiet tapestry.checks
@quiet press.checks
@quiet loom.checks
@quiet gutenberg.checks
@quiet jacquard.checks
@quiet vm-unmasked.checks

# VM boot files (kento VM mode)
vmlinuz exists	test -f /boot/vmlinuz
initramfs.img exists	test -f /boot/initramfs.img

# VM boot readiness
fstab has no mount entries	! grep -qvE '^#|^$' /etc/fstab
droste password not locked	grep '^droste:' /etc/shadow | grep -qv '!'
droste in sudo group	id -nG droste | grep -qw sudo
droste in kvm group	id -nG droste | grep -qw kvm
systemd-networkd DHCP config	grep -q '^Type=ether$' /etc/systemd/network/80-dhcp.network
systemd-networkd enabled	test -L /etc/systemd/system/multi-user.target.wants/systemd-networkd.service
serial-getty@ttyS0 enabled	test -L /etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service

# VM-only packages
qemu-guest-agent installed	dpkg -s qemu-guest-agent 2>/dev/null | grep -q '^Status: install'
qemu-system-x86_64 binary present	command -v qemu-system-x86_64 >/dev/null
virtiofsd installed	dpkg -s virtiofsd 2>/dev/null | grep -q '^Status: install'
swtpm installed	dpkg -s swtpm 2>/dev/null | grep -q '^Status: install'
pve-edk2-firmware-ovmf installed	dpkg -s pve-edk2-firmware-ovmf 2>/dev/null | grep -q '^Status: install'
nbdkit installed	dpkg -s nbdkit 2>/dev/null | grep -q '^Status: install'
nfs-kernel-server installed	dpkg -s nfs-kernel-server 2>/dev/null | grep -q '^Status: install'
cpu-checker installed	dpkg -s cpu-checker 2>/dev/null | grep -q '^Status: install'
irqbalance installed	dpkg -s irqbalance 2>/dev/null | grep -q '^Status: install'
linux-cpupower installed	dpkg -s linux-cpupower 2>/dev/null | grep -q '^Status: install'
fence-agents installed	dpkg -s fence-agents 2>/dev/null | grep -q '^Status: install'
numactl installed	dpkg -s numactl 2>/dev/null | grep -q '^Status: install'

# VM kernel module config
kvm nested virt config	test -f /etc/modprobe.d/kvm-nested.conf

# Proxmox VE (pct/qm + pmxcfs, PVE-variant pinned)
pct available	command -v pct >/dev/null
qm available	command -v qm >/dev/null
qemu-server installed	dpkg -s qemu-server 2>/dev/null | grep -q '^Status: install'
pve-container installed	dpkg -s pve-container 2>/dev/null | grep -q '^Status: install'
pve-cluster installed	dpkg -s pve-cluster 2>/dev/null | grep -q '^Status: install'
pve-qemu-kvm installed	dpkg -s pve-qemu-kvm 2>/dev/null | grep -q '^Status: install'
lxc-pve installed	dpkg -s lxc-pve 2>/dev/null | grep -q '^Status: install'
proxmox origin pinned	grep -q 'o=Proxmox' /etc/apt/preferences.d/proxmox
pmxcfs present	test -x /usr/bin/pmxcfs
no proxmox kernel pulled	! dpkg -l 2>/dev/null | grep -qE '^ii\s+proxmox-(default-)?kernel'
pve enterprise repo absent	! test -f /etc/apt/sources.list.d/pve-enterprise.list
pve no-subscription repo present	test -f /etc/apt/sources.list.d/pve-no-subscription.list
