@quiet seed.checks
@quiet lint.checks
@quiet fiber.checks

# Kernel-dependent (thread additions)
ipvsadm available	test -x /usr/sbin/ipvsadm
molly-guard available	test -x /usr/lib/molly-guard/molly-guard
mount.cifs available	test -x /usr/sbin/mount.cifs
nfs client available	test -x /usr/sbin/mount.nfs
fatrace available	test -x /usr/sbin/fatrace
lxcfs available	command -v lxcfs

# Sysctl (config file, not runtime)
IPv4 forwarding configured	grep -q 'net.ipv4.ip_forward = 1' /etc/sysctl.d/99-droste.conf
IPv6 forwarding configured	grep -q 'net.ipv6.conf.all.forwarding = 1' /etc/sysctl.d/99-droste.conf

# Podman runtime dependencies (decomposed in lieu of `podman info`, which
# fails under docker's default seccomp/apparmor in CI — these cover the
# common regression surfaces: missing runtime, setuid bits, and storage
# backend dependencies). The networking backend (pasta) is checked in
# fiber.checks, where the passt package is installed.
crun callable	crun --version
conmon callable	command -v conmon
newuidmap setuid	test -u /usr/bin/newuidmap
newgidmap setuid	test -u /usr/bin/newgidmap
fuse-overlayfs callable	command -v fuse-overlayfs

# Container management (moved from fiber — requires systemd)
lxc-create available	lxc-create --version
systemd-nspawn available	command -v systemd-nspawn
machinectl available	command -v machinectl

# Kento (OCI lifecycle)
kento available	kento --version
