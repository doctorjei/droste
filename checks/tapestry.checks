@quiet seed.checks
@quiet lint.checks
@quiet fiber.checks
@quiet thread.checks
@quiet sheet.checks
@quiet yarn.checks
@quiet page.checks
@quiet fabric.checks
@quiet tome.checks

# Kernel-dependent (tapestry additions)
sg_inq available	command -v sg_inq
smartctl available	test -x /usr/sbin/smartctl
aa-status available	command -v aa-status
qemu-system-arm available	command -v qemu-system-arm

@stop
# HA/storage daemons disabled on boot in LXC (packages stay installed).
# Tier-local (below @stop): NOT inherited by wool, which re-enables some.
# Target-agnostic: these units' WantedBy targets vary, so glob all *.wants/.
sbd disabled	! ls /etc/systemd/system/*.wants/sbd.service >/dev/null 2>&1
sbd_remote disabled	! ls /etc/systemd/system/*.wants/sbd_remote.service >/dev/null 2>&1
rtslib-fb-targetctl disabled	! ls /etc/systemd/system/*.wants/rtslib-fb-targetctl.service >/dev/null 2>&1
openvswitch-switch disabled	! ls /etc/systemd/system/*.wants/openvswitch-switch.service >/dev/null 2>&1
bird disabled	! ls /etc/systemd/system/*.wants/bird.service >/dev/null 2>&1
dnsmasq disabled	! ls /etc/systemd/system/*.wants/dnsmasq.service >/dev/null 2>&1
