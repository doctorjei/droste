@quiet seed.checks
@quiet lint.checks
@quiet fiber.checks
@quiet thread.checks
@quiet sheet.checks
@quiet yarn.checks
@quiet page.checks
@quiet fabric.checks
@quiet tome.checks
@quiet tapestry.checks
@quiet press.checks
@quiet loom.checks
@quiet vm-unmasked.checks

# VM boot files (kento VM mode)
vmlinuz exists	test -f /boot/vmlinuz
initramfs.img exists	test -f /boot/initramfs.img

# VM boot readiness
fstab has no mount entries	test -f /etc/fstab && ! grep -qvE '^#|^$' /etc/fstab
droste password not locked	grep '^droste:' /etc/shadow | grep -qv '!'
droste in sudo group	id -nG droste | grep -qw sudo
droste in kvm group	id -nG droste | grep -qw kvm
systemd-networkd DHCP config	grep -q '^Name=en\* eth\*$' /etc/systemd/network/80-dhcp.network
networkd veth-unmanaged match	grep -q '^Kind=veth$' /etc/systemd/network/10-lxc-veth-unmanaged.network
networkd veth-unmanaged link	grep -q '^Unmanaged=yes$' /etc/systemd/network/10-lxc-veth-unmanaged.network
systemd-networkd enabled	test -L /etc/systemd/system/multi-user.target.wants/systemd-networkd.service
serial-getty@ttyS0 enabled	test -L /etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service

# VM-only packages
qemu-guest-agent installed	dpkg -s qemu-guest-agent 2>/dev/null | grep -q '^Status: install ok installed'
watchdog installed	dpkg -s watchdog 2>/dev/null | grep -q '^Status: install ok installed'
qemu-system-x86 installed	dpkg -s qemu-system-x86 2>/dev/null | grep -q '^Status: install ok installed'
virtiofsd installed	dpkg -s virtiofsd 2>/dev/null | grep -q '^Status: install ok installed'
swtpm installed	dpkg -s swtpm 2>/dev/null | grep -q '^Status: install ok installed'
ovmf installed	dpkg -s ovmf 2>/dev/null | grep -q '^Status: install ok installed'
libvirt-daemon-system installed	dpkg -s libvirt-daemon-system 2>/dev/null | grep -q '^Status: install ok installed'
virtinst installed	dpkg -s virtinst 2>/dev/null | grep -q '^Status: install ok installed'
nbdkit installed	dpkg -s nbdkit 2>/dev/null | grep -q '^Status: install ok installed'
nfs-kernel-server installed	dpkg -s nfs-kernel-server 2>/dev/null | grep -q '^Status: install ok installed'
cpu-checker installed	dpkg -s cpu-checker 2>/dev/null | grep -q '^Status: install ok installed'
irqbalance installed	dpkg -s irqbalance 2>/dev/null | grep -q '^Status: install ok installed'
linux-cpupower installed	dpkg -s linux-cpupower 2>/dev/null | grep -q '^Status: install ok installed'
fence-agents installed	dpkg -s fence-agents 2>/dev/null | grep -q '^Status: install ok installed'
numactl installed	dpkg -s numactl 2>/dev/null | grep -q '^Status: install ok installed'

# VM kernel module config
kvm nested virt config	test -f /etc/modprobe.d/kvm-nested.conf
nbd module autoload	grep -q nbd /etc/modules-load.d/droste.conf
drbd module autoload	grep -q drbd /etc/modules-load.d/droste.conf
