#!/usr/bin/env bash
# Build, test, and manage droste images.
#
# Usage:
#   scripts/drostify build fiber              # build fiber
#   scripts/drostify build all --force        # rebuild all tiers
#   scripts/drostify test sheet               # test sheet
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

trap 'echo ""; echo "--- drostify finished at $(date "+%Y-%m-%d %H:%M:%S") ---"' EXIT

# ── Globals ─────────────────────────────────────────────────────────
declare -A FORCE_TIERS=()
VERBOSE=false

# ── Tier name registry ──────────────────────────────────────────────
# Index-aligned: LAYER_APP[i], LAYER_SYS[i], LAYER_VM[i] are siblings.
# Parent chain: app[0] → app[1] → ... → app[6] (process containers)
#               sys[i] is the system container child of app[i]
#               vm[i] is the VM-bootable child of sys[i]
#
# To rename tiers, change ONLY these three arrays. Everything else
# (tier lists, parent mappings, parsers, help text) derives from them.
LAYER_APP=(seed  fiber   sheet  page    tome      press    gutenberg)
LAYER_SYS=(lint  thread  yarn   fabric  tapestry  loom     jacquard)
LAYER_VM=(root   hair    wool   felt    amimono   stuffer  stuffinator)

# ── Derived tier arrays ─────────────────────────────────────────────
ALL_APP_TIERS=("${LAYER_APP[@]}")
ALL_SYS_TIERS=("${LAYER_SYS[@]}")
ALL_VM_TIERS=("${LAYER_VM[@]}")

# Interleaved build order: app[i], sys[i], vm[i] for each layer.
# This is also the correct dependency order and downstream order.
ALL_TIERS=()
for _i in "${!LAYER_APP[@]}"; do
    ALL_TIERS+=("${LAYER_APP[$_i]}" "${LAYER_SYS[$_i]}" "${LAYER_VM[$_i]}")
done
unset _i

# ── Tier helpers ────────────────────────────────────────────────────
is_tier() {
    case "$1" in app-all|sys-all|vm-all) return 0 ;; esac
    local t
    for t in "${ALL_TIERS[@]}"; do
        [[ "$t" == "$1" ]] && return 0
    done
    return 1
}

# Return the parent tier for a given tier.
tier_parent() {
    local tier="$1"
    local i
    for i in "${!LAYER_APP[@]}"; do
        if [[ "$tier" == "${LAYER_APP[$i]}" ]]; then
            [[ $i -gt 0 ]] && echo "${LAYER_APP[$((i-1))]}" || echo ""
            return
        fi
        if [[ "$tier" == "${LAYER_SYS[$i]}" ]]; then
            echo "${LAYER_APP[$i]}"
            return
        fi
        if [[ "$tier" == "${LAYER_VM[$i]}" ]]; then
            echo "${LAYER_SYS[$i]}"
            return
        fi
    done
}

detect_container_cmd() {
    # Explicit override for environments where both runtimes are present
    # but only one sees the image (e.g. CI where docker/build-push-action
    # loads into docker but the runner also has podman).
    if [[ -n "${CONTAINER_CMD:-}" ]]; then
        echo "$CONTAINER_CMD"
        return
    fi
    if command -v podman &>/dev/null; then
        echo podman
    elif command -v docker &>/dev/null; then
        echo docker
    else
        echo "Error: neither podman nor docker found" >&2
        exit 1
    fi
}

# ── Usage ───────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: $(basename "$0") [COMMAND] [IMAGE] [OPTIONS]

Build and test droste images.

Commands:
  build      Build the image(s)
  test       Run smoke tests on existing image(s)
  help       Show this help message

Tiers:
EOF
    # Generate tier list from arrays
    local i
    for i in "${!LAYER_APP[@]}"; do
        printf "  %-14s Process container (layer %d)\n" "${LAYER_APP[$i]}" "$i"
        printf "  %-14s System container (kento)\n" "${LAYER_SYS[$i]}"
        printf "  %-14s VM-bootable (kento VM mode)\n" "${LAYER_VM[$i]}"
    done
    cat <<EOF
  app-all      All app/process containers
  sys-all      All system containers
  vm-all       All VM-bootable containers
  all          All tiers (app + sys + vm)

Options:
  --force            Rebuild named tier(s) and all downstream dependents
  --force-tier       Rebuild only the named tier(s), without cascading
                     to downstream dependents
  --deps             Also rebuild ancestor dependencies (combine with
                     --force or --force-tier)
  --verbose          Show full build output (builds are quiet by default)
  --debug            Alias for --verbose

  --force cascades by default: rebuilding a tier invalidates its
  downstream dependents, so they are included in the forced set.
  Use --force-tier to force only the named tier(s) without cascading.
  Add --deps to either to also force ancestor dependencies.

Examples:
  $(basename "$0") build ${LAYER_APP[1]}                          # build ${LAYER_APP[1]}
  $(basename "$0") build ${LAYER_SYS[1]}                      # build bootable ${LAYER_SYS[1]} for kento
  $(basename "$0") test ${LAYER_APP[2]}                           # test ${LAYER_APP[2]}
  $(basename "$0") build all                              # build all, skip existing
  $(basename "$0") build all --force                      # rebuild everything
  $(basename "$0") build ${LAYER_APP[2]} --force                  # rebuild ${LAYER_APP[2]} + all downstream
  $(basename "$0") build ${LAYER_APP[2]} --force-tier             # rebuild only ${LAYER_APP[2]}
  $(basename "$0") build sys-all --force --deps            # rebuild sys tiers + app ancestors + downstream
  $(basename "$0") build sys-all --force-tier --deps       # rebuild sys tiers + app ancestors (no downstream)
EOF
}

# ── Test ────────────────────────────────────────────────────────
do_test() {
    local tier="$1"
    local image="droste-${tier}"
    local checkfile="$PROJECT_DIR/checks/${tier}.checks"
    local container_cmd
    container_cmd=$(detect_container_cmd)

    if [[ ! -f "$checkfile" ]]; then
        echo "Warning: no check file found: $checkfile" >&2
        return 0
    fi

    echo "droste-${tier} test"
    echo "======================"
    echo ""

    local cname="droste-test-${tier}"
    if ! $container_cmd image inspect "$image" >/dev/null 2>&1; then
        echo "Error: image $image not found — build it first: drostify build $tier" >&2
        return 1
    fi
    $container_cmd rm -f "$cname" &>/dev/null || true
    $container_cmd run -d --name "$cname" "$image" sleep infinity >/dev/null

    local pass=0 fail=0 errors=()
    local out

    # Run @quiet inherited check files (failures only)
    while IFS= read -r line; do
        [[ "$line" =~ ^@quiet\  ]] || continue
        local qfile="${line#@quiet }"
        qfile="$PROJECT_DIR/checks/$qfile"
        [[ -f "$qfile" ]] || { echo "Warning: quiet file not found: $qfile" >&2; continue; }
        # @stop marks checks private to this file — run for its own `test`,
        # but NOT inherited by children via @quiet.
        while IFS= read -r qline; do
            [[ -z "$qline" ]] && continue
            [[ "$qline" =~ ^# ]] && continue
            [[ "$qline" =~ ^@ ]] && continue
            IFS=$'\t' read -r desc cmd flag <<< "$qline"
            if [[ -z "$cmd" ]]; then
                echo "  - FAIL (${qfile##*/}): malformed check line (no tab / empty command): $desc"
                errors+=("(${qfile##*/}) malformed: $desc")
                fail=$((fail + 1))
                continue
            fi
            if out=$($container_cmd exec "$cname" bash -c "$cmd" 2>&1); then
                pass=$((pass + 1))
            else
                echo "  - FAIL (${qfile##*/}): $desc"
                echo "      cmd: $cmd"
                [[ -n "$out" ]] && printf '      out: %s\n' "$out" | sed -n '1,3p'
                errors+=("(${qfile##*/}) $desc")
                fail=$((fail + 1))
            fi
        done < <(sed '/@stop/,$d' "$qfile")
    done < "$checkfile"

    # Run this file's own tests verbosely (skip directives)
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^@ ]] && continue
        if [[ "$line" =~ ^#\  ]]; then
            echo "${line#\# }:"
            continue
        fi
        IFS=$'\t' read -r desc cmd flag <<< "$line"
        if [[ -z "$cmd" ]]; then
            echo "  - FAIL: malformed check line (no tab / empty command): $desc"
            errors+=("malformed: $desc")
            fail=$((fail + 1))
            continue
        fi
        if out=$($container_cmd exec "$cname" bash -c "$cmd" 2>&1); then
            echo "  + $desc"
            pass=$((pass + 1))
        else
            echo "  - FAIL: $desc"
            echo "      cmd: $cmd"
            [[ -n "$out" ]] && printf '      out: %s\n' "$out" | sed -n '1,3p'
            errors+=("$desc")
            fail=$((fail + 1))
        fi
    done < "$checkfile"

    $container_cmd rm -f "$cname" >/dev/null || true

    echo ""
    echo "================================"
    echo "Results: ${pass} passed, ${fail} failed"

    if [[ ${fail} -gt 0 ]]; then
        echo ""
        echo "Failures:"
        for err in "${errors[@]}"; do
            echo "  - $err"
        done
        return 1
    fi
}

# ── Build ───────────────────────────────────────────────────────
do_build() {
    local tier="$1"
    local container_cmd
    container_cmd=$(detect_container_cmd)

    # Skip if image exists and tier is not forced
    if [[ -z "${FORCE_TIERS[$tier]+x}" ]]; then
        if $container_cmd image exists "droste-${tier}" 2>/dev/null; then
            echo "droste-${tier}: exists, skipping (use --force to rebuild)"
            return 0
        fi
    fi

    # Map tier → parent image for BASE_IMAGE arg
    local parent
    parent=$(tier_parent "$tier")

    echo "Building droste-${tier} container..."
    echo ""

    local build_args=()
    if [[ -n "$parent" ]]; then
        build_args+=(--build-arg "BASE_IMAGE=localhost/droste-${parent}")
    fi

    if [[ "$VERBOSE" == true ]]; then
        $container_cmd build \
            "${build_args[@]}" \
            -t "droste-${tier}" \
            -f "$PROJECT_DIR/containers/droste-${tier}/Containerfile" \
            "$PROJECT_DIR"
    else
        local logfile
        logfile=$(mktemp /tmp/droste-build-XXXXXX.log)
        set -o pipefail
        if $container_cmd build \
            "${build_args[@]}" \
            -t "droste-${tier}" \
            -f "$PROJECT_DIR/containers/droste-${tier}/Containerfile" \
            "$PROJECT_DIR" 2>&1 | tee "$logfile" \
            | grep --line-buffered -E '^STEP |^COMMIT |^Successfully '; then
            rm -f "$logfile"
        else
            echo ""
            echo "Build failed. Full output:"
            cat "$logfile"
            rm -f "$logfile"
            return 1
        fi
        set +o pipefail
    fi

    echo ""
    echo "Build complete."
    $container_cmd image inspect "droste-${tier}" --format '{{.Size}}' | \
        awk '{printf "Image size: %.0f MB\n", $1/1024/1024}' || true
    echo ""
    do_test "$tier"
}

# ── Tier resolution ────────────────────────────────────────────
# Return dependency chain: all ancestors from seed through target.
resolve_deps() {
    local target="$1"
    local chain=()
    local current="$target"
    # Walk up the parent chain
    while [[ -n "$current" ]]; do
        chain=("$current" "${chain[@]}")
        current=$(tier_parent "$current")
    done
    echo "${chain[@]}"
}

# Return target tier + all downstream dependents (graph walk via tier_parent).
resolve_downstream() {
    local from="$1"
    local -A visited=()
    local changed=true tier

    visited["$from"]=1
    while [[ "$changed" == true ]]; do
        changed=false
        for tier in "${ALL_TIERS[@]}"; do
            [[ -n "${visited[$tier]+x}" ]] && continue
            local p
            p=$(tier_parent "$tier")
            if [[ -n "$p" && -n "${visited[$p]+x}" ]]; then
                visited["$tier"]=1
                changed=true
            fi
        done
    done
    # Output in build order
    for tier in "${ALL_TIERS[@]}"; do
        [[ -n "${visited[$tier]+x}" ]] && echo "$tier"
    done
}

# Return tiers to build for a target (dependency order).
resolve_tiers() {
    local target="$1"
    case "$target" in
        all)     echo "${ALL_TIERS[@]}" ;;
        app-all) echo "${ALL_APP_TIERS[@]}" ;;
        sys-all) echo "${ALL_SYS_TIERS[@]}" ;;
        vm-all)  echo "${ALL_VM_TIERS[@]}" ;;
        *)       resolve_deps "$target" ;;
    esac
}

# Expand a target's build list to include all ancestors of each tier.
# For single tiers this is the same as resolve_deps. For group
# targets (sys-all, vm-all) it pulls in ancestor tiers outside the group.
resolve_with_deps() {
    local target="$1"
    local -A include
    local t dep
    for t in $(resolve_tiers "$target"); do
        for dep in $(resolve_deps "$t"); do
            include["$dep"]=1
        done
    done
    for tier in "${ALL_TIERS[@]}"; do
        [[ -n "${include[$tier]+x}" ]] && echo "$tier"
    done
}

# Expand a target's build list to include all downstream of each tier.
# For single tiers this is the same as resolve_with_deps + downstream. For
# group targets (app-all) it pulls in downstream tiers outside the group.
resolve_with_cascade() {
    local target="$1"
    local -A include
    local t down
    for t in $(resolve_tiers "$target"); do
        for down in $(resolve_downstream "$t"); do
            include["$down"]=1
        done
    done
    # Also include deps so the build order is complete
    for t in $(resolve_tiers "$target"); do
        for dep in $(resolve_deps "$t"); do
            include["$dep"]=1
        done
    done
    for tier in "${ALL_TIERS[@]}"; do
        [[ -n "${include[$tier]+x}" ]] && echo "$tier"
    done
}

# ── Parse command and image ──────────────────────────────────────────
COMMAND="build"
IMAGE="all"
FORCE=false
FORCE_TIER=false
DEPS=false

if [[ $# -gt 0 ]]; then
    case "$1" in
        build-all)
            # Legacy alias: treat as "build all" with remaining args
            COMMAND="build"
            IMAGE="all"
            shift
            ;;
        build|test|help|-h|--help)
            COMMAND="$1"
            shift
            ;;
        *)
            if is_tier "$1" || [[ "$1" == "all" ]]; then
                IMAGE="$1"
                shift
            else
                echo "Unknown argument: $1" >&2
                usage >&2
                exit 1
            fi
            ;;
    esac
fi

if [[ $# -gt 0 ]]; then
    if is_tier "$1" || [[ "$1" == "all" ]]; then
        IMAGE="$1"
        shift
    elif [[ "$1" != -* ]]; then
        # A non-flag argument in the tier slot that isn't a known tier is a
        # tier typo, not an option problem. Report it as such.
        echo "Error: unknown tier or target: $1" >&2
        echo "Run '$(basename "$0") --help' for valid tiers and options." >&2
        exit 1
    fi
fi

# ── Parse global options ─────────────────────────────────────────────
force_seen=false
force_tier_seen=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --force)          FORCE=true; force_seen=true; shift ;;
        --force-tier)     FORCE_TIER=true; force_tier_seen=true; shift ;;
        --deps)           DEPS=true; shift ;;
        --verbose|--debug) VERBOSE=true; shift ;;
        *)                echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done

if [[ "$force_seen" == true && "$force_tier_seen" == true ]]; then
    echo "Error: --force and --force-tier are mutually exclusive" >&2
    exit 1
fi

# ── Compute build list and populate FORCE_TIERS ─────────────────────
# --force-tier implies force
[[ "$FORCE_TIER" == true ]] && FORCE=true

# --force cascades downstream by default; --force-tier does not.
# --deps expands the build list to include ancestors.
if [[ "$FORCE" == true && "$FORCE_TIER" != true ]]; then
    # --force: cascade downstream + include deps if requested
    if [[ "$DEPS" == true ]]; then
        declare -A _all_tiers=()
        for t in $(resolve_with_cascade "$IMAGE"); do _all_tiers["$t"]=1; done
        for t in $(resolve_with_deps "$IMAGE"); do _all_tiers["$t"]=1; done
        BUILD_TIERS=""
        for tier in "${ALL_TIERS[@]}"; do
            [[ -n "${_all_tiers[$tier]+x}" ]] && BUILD_TIERS+="$tier "
        done
        # --force --deps: force everything (ancestors + named + downstream)
        for t in $BUILD_TIERS; do FORCE_TIERS["$t"]=1; done
    else
        BUILD_TIERS=$(resolve_with_cascade "$IMAGE")
        # --force: force named tier(s) + downstream, not ancestors
        for t in $(resolve_tiers "$IMAGE"); do
            for d in $(resolve_downstream "$t"); do
                FORCE_TIERS["$d"]=1
            done
        done
    fi
elif [[ "$FORCE_TIER" == true ]]; then
    # --force-tier: no cascade, optionally include ancestor deps
    if [[ "$DEPS" == true ]]; then
        BUILD_TIERS=$(resolve_with_deps "$IMAGE")
    else
        BUILD_TIERS=$(resolve_tiers "$IMAGE")
    fi
    # Force only the named/group tiers
    for t in $(resolve_tiers "$IMAGE"); do FORCE_TIERS["$t"]=1; done
else
    BUILD_TIERS=$(resolve_tiers "$IMAGE")
fi

# ── Main ────────────────────────────────────────────────────────────
case "$COMMAND" in
    build)
        for tier in $BUILD_TIERS; do
            echo ""
            do_build "$tier"
        done
        ;;
    test)
        # Group targets expand to multiple tiers; a single-tier target
        # tests ONLY that tier. (Ancestor checks still run — a tier's
        # .checks file @quiet-inherits its parents' check files and
        # evaluates them inside the tier's own container.) Testing
        # ancestors separately as standalone containers fails in CI
        # where only the current job's image is loaded.
        case "$IMAGE" in
            all|app-all|sys-all|vm-all)
                for tier in $(resolve_tiers "$IMAGE"); do
                    echo ""
                    do_test "$tier"
                done
                ;;
            *)
                do_test "$IMAGE"
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        usage >&2
        exit 1
        ;;
esac
