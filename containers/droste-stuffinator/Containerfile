ARG BASE_IMAGE=droste-jacquard

FROM ghcr.io/doctorjei/gemet/boot:1.7.2 AS gemet-boot

FROM ${BASE_IMAGE}

LABEL description="droste-stuffinator: VM-bootable jacquard (kento VM mode)"

COPY --from=gemet-boot /boot/vmlinuz /boot/vmlinuz
COPY --from=gemet-boot /boot/initramfs.img /boot/initramfs.img

# VM-only packages (not useful in system/LXC containers).
# NOTE: watchdog, libvirt-daemon-system, and virtinst are intentionally
# absent here (unlike the other wool tiers) — PVE displaces them on this
# tier: pve-ha-manager Conflicts watchdog (it ships its own watchdog-mux),
# and pve-qemu-kvm doesn't satisfy libvirt's qemu-system dependency, so
# apt would remove the libvirt stack during the PVE install anyway. PVE
# manages VMs directly (qm), so libvirt/virtinst are redundant here.
RUN apt-get -qq update \
    && apt-get install -y -qq --no-install-recommends \
       qemu-guest-agent \
       virtiofsd nbdkit \
       nfs-kernel-server cpu-checker irqbalance linux-cpupower \
       fence-agents numactl \
    && rm -rf /var/lib/apt/lists/*

# VM kernel module config (nbd/drbd are builtin in gemet's kernel now)
RUN printf 'options kvm_intel nested=1\noptions kvm_amd nested=1\n' \
       > /etc/modprobe.d/kvm-nested.conf

# Proxmox VE qemu half: qemu-server gives qm and pulls pve-qemu-kvm +
# swtpm+pve + pve-edk2-firmware-ovmf. The PVE node stack (pct/pvesm/pmxcfs +
# HA) plus the proxmox repo, signing key, and origin pin are all inherited
# from jacquard — stuffinator only adds the qemu/qm half here. NO proxmox-ve
# metapackage, NO pve-manager web stack, NO ZFS, NO proxmox kernel: stuffinator
# keeps the gemet kernel it COPYs. Note: qm runtime needs gemet's KVM-host
# kernel; the package install itself is kernel-independent. Its own policy-rc.d
# (exit 101) guard is required because jacquard removed policy-rc.d at the end
# of its own RUN and that file does not carry across layers.
RUN printf 'exit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get -qq update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
       qemu-server \
    && rm -f /usr/sbin/policy-rc.d \
    && rm -rf /var/lib/apt/lists/*

# VM boot fixes: set login password, enable DHCP + serial console
RUN echo 'droste:droste' | chpasswd \
    && usermod -aG sudo droste \
    && usermod -aG kvm droste \
    && mkdir -p /etc/systemd/network \
    && printf '[Match]\nName=en* eth*\n\n[Network]\nDHCP=yes\n' \
       > /etc/systemd/network/80-dhcp.network \
    && printf '[Match]\nKind=veth\n\n[Link]\nUnmanaged=yes\n' \
       > /etc/systemd/network/10-lxc-veth-unmanaged.network \
    && systemctl enable systemd-networkd \
    && systemctl enable serial-getty@ttyS0.service
