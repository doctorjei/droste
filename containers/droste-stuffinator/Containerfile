ARG BASE_IMAGE=droste-jacquard

FROM ghcr.io/doctorjei/gemet/boot:1.7.3 AS gemet-boot

FROM ${BASE_IMAGE}

LABEL description="droste-stuffinator: VM-bootable jacquard (kento VM mode)"

COPY --from=gemet-boot /boot/vmlinuz /boot/vmlinuz
COPY --from=gemet-boot /boot/initramfs.img /boot/initramfs.img

# VM-only packages (not useful in system/LXC containers).
# NOTE: watchdog, libvirt-daemon-system, and virtinst are intentionally
# absent here (unlike the other wool tiers) — PVE displaces them on this
# tier: pve-ha-manager Conflicts watchdog (it ships its own watchdog-mux),
# and pve-qemu-kvm doesn't satisfy libvirt's qemu-system dependency, so
# apt would remove the libvirt stack during the PVE install anyway. PVE
# manages VMs directly (qm), so libvirt/virtinst are redundant here.
RUN apt-get -qq update \
    && apt-get install -y -qq --no-install-recommends \
       qemu-guest-agent \
       virtiofsd nbdkit \
       nfs-kernel-server cpu-checker irqbalance linux-cpupower \
       fence-agents numactl auditd \
    && rm -rf /var/lib/apt/lists/*

# VM kernel module config (nbd/drbd are builtin in gemet's kernel now)
RUN printf 'options kvm_intel nested=1\noptions kvm_amd nested=1\n' \
       > /etc/modprobe.d/kvm-nested.conf

# Proxmox VE: pct/qm + pmxcfs (/etc/pve) on top of the full VM toolset. NO
# proxmox-ve metapackage (it hard-depends a proxmox kernel), NO pve-manager
# web stack, NO ZFS, NO proxmox kernel — stuffinator keeps the gemet kernel
# it COPYs. An apt origin pin (o=Proxmox, Pin-Priority 1001) makes PVE
# variants authoritatively win for overlapping packages (swtpm/lxcfs/lvm2/
# corosync resolve to their +pve builds). Note: pve-vm/qm runtime needs
# gemet's KVM-host kernel; the package install itself is kernel-independent.
# policy-rc.d suppresses service starts so the pve-cluster/pmxcfs postinst
# doesn't fail without a real cluster.
RUN wget --tries=3 -qO /tmp/pve.gpg https://enterprise.proxmox.com/debian/proxmox-release-trixie.gpg \
    && test -s /tmp/pve.gpg \
    && mv /tmp/pve.gpg /usr/share/keyrings/proxmox-release-trixie.gpg \
    && printf 'deb [signed-by=/usr/share/keyrings/proxmox-release-trixie.gpg] http://download.proxmox.com/debian/pve trixie pve-no-subscription\n' \
       > /etc/apt/sources.list.d/pve-no-subscription.list \
    && printf 'Package: *\nPin: release o=Proxmox\nPin-Priority: 1001\n' \
       > /etc/apt/preferences.d/proxmox \
    && echo 'postfix postfix/main_mailer_type select No configuration' | debconf-set-selections \
    && printf 'exit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d

# Install minimal PVE: pct/qm + pmxcfs
RUN apt-get -qq update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
       qemu-server pve-container pve-cluster

# Remove the install-time service-start guard + repo cruft
RUN rm -f /usr/sbin/policy-rc.d \
    && rm -f /etc/apt/sources.list.d/pve-enterprise.list \
    && rm -rf /var/lib/apt/lists/*

# VM boot fixes: set login password, enable DHCP + serial console
RUN echo 'droste:droste' | chpasswd \
    && usermod -aG sudo droste \
    && usermod -aG kvm droste \
    && mkdir -p /etc/systemd/network \
    && printf '[Match]\nName=en* eth*\n\n[Network]\nDHCP=yes\n' \
       > /etc/systemd/network/80-dhcp.network \
    && printf '[Match]\nName=!eth0\nKind=veth\n\n[Link]\nUnmanaged=yes\n' \
       > /etc/systemd/network/10-lxc-veth-unmanaged.network \
    && systemctl enable systemd-networkd \
    && systemctl enable serial-getty@ttyS0.service \
    && systemctl enable auditd.service \
    && systemctl enable rtslib-fb-targetctl.service \
    && systemctl enable openvswitch-switch.service
