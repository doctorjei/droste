ARG BASE_IMAGE=droste-seed
FROM ${BASE_IMAGE}

LABEL description="droste-lint: bootable seed (kento system container)"

# Adds back the system packages that were stripped from droste-seed
# (systemd, dbus, udev, cloud-init, etc.). The result can boot as a
# system container (systemd PID 1) via kento.

COPY oci/seed-oci-exclude.txt /tmp/seed-oci-exclude.txt
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
       $(grep -v '^#' /tmp/seed-oci-exclude.txt | grep -v '^$') \
    && rm -f /tmp/seed-oci-exclude.txt \
    && rm -rf /var/lib/apt/lists/*

# Restrict cloud-init datasource probes (NoCloud + ConfigDrive + None)
COPY oci/cloud-init-droste.cfg /etc/cloud/cloud.cfg.d/99-droste.cfg

# Mask services that break LXC (growfs needs block device, remount-fs needs fstab)
RUN systemctl mask systemd-growfs-root.service systemd-remount-fs.service

# Enable getty on /dev/console for LXC console access
RUN systemctl enable getty@console.service

CMD ["/sbin/init"]
