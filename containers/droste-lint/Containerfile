ARG BASE_IMAGE=droste-seed
FROM ${BASE_IMAGE}

LABEL description="droste-lint: bootable seed (kento system container)"

# Adds back the system packages that were stripped from droste-seed
# (systemd, dbus, udev, cloud-init, etc.). The result can boot as a
# system container (systemd PID 1) via kento.

COPY oci/seed-oci-exclude.txt /tmp/seed-oci-exclude.txt
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
       $(grep -v '^#' /tmp/seed-oci-exclude.txt | grep -v '^$') \
    && rm -f /tmp/seed-oci-exclude.txt \
    && rm -rf /var/lib/apt/lists/*

# Restrict cloud-init datasource probes (NoCloud + ConfigDrive + None)
COPY oci/cloud-init-droste.cfg /etc/cloud/cloud.cfg.d/99-droste.cfg

# Mask services that break LXC (growfs needs block device, remount-fs needs fstab)
RUN systemctl mask systemd-growfs-root.service systemd-remount-fs.service

# Enable getty on /dev/console for LXC console access
RUN systemctl enable getty@console.service

# Enable ssh.service and systemd-networkd at the lint layer.
#
# openssh-server is installed at seed (canopy-restore.txt) while systemd
# is still stripped; its deb-systemd-helper postinst no-ops because the
# systemd state tree isn't initialized. Later `systemctl enable` calls
# at this layer also silently no-op — even after systemd-sysv lands via
# seed-oci-exclude.txt, the helper state flags set at seed leave the
# enable indirection broken. (Phase B Test 2 regression, 2026-04-21:
# `systemctl enable ssh.service systemd-networkd.service` at this layer
# produced zero symlinks in the rootfs.)
#
# Fix: create the enable symlinks directly. This is exactly what a
# working `systemctl enable` does internally, and the WantedBy=multi-
# user.target install path for these services has been stable for 15+
# years. The inline `test -L` assertions after the links fail the build
# immediately if a regression breaks this — so a silent no-op cannot
# ship to GHCR again.
#
# systemd-networkd is also preset: enabled, but preset only applies on
# first boot via systemd-update-done; container lifecycles that skip
# first-boot (existing /etc/machine-id from build) leave it disabled.
# kento drops .network files into /etc/systemd/network/ expecting
# networkd to be running, so we guarantee it regardless of preset.
RUN mkdir -p /etc/systemd/system/multi-user.target.wants \
    && test -f /usr/lib/systemd/system/ssh.service \
    && test -f /usr/lib/systemd/system/systemd-networkd.service \
    && ln -sf /usr/lib/systemd/system/ssh.service \
              /etc/systemd/system/multi-user.target.wants/ssh.service \
    && ln -sf /usr/lib/systemd/system/systemd-networkd.service \
              /etc/systemd/system/multi-user.target.wants/systemd-networkd.service \
    && test -L /etc/systemd/system/multi-user.target.wants/ssh.service \
    && test -L /etc/systemd/system/multi-user.target.wants/systemd-networkd.service

CMD ["/sbin/init"]
