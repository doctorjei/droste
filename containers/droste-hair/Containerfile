ARG BASE_IMAGE=droste-thread

FROM ghcr.io/doctorjei/gemet/boot:1.7.2 AS gemet-boot

FROM ${BASE_IMAGE}

LABEL description="droste-hair: VM-bootable thread (kento VM mode)"

COPY --from=gemet-boot /boot/vmlinuz /boot/vmlinuz
COPY --from=gemet-boot /boot/initramfs.img /boot/initramfs.img

# VM-only packages (not useful in system/LXC containers)
RUN apt-get -qq update \
    && apt-get install -y -qq --no-install-recommends \
       qemu-guest-agent watchdog \
    && rm -rf /var/lib/apt/lists/*

# VM boot fixes: set login password, enable DHCP + serial console
RUN echo 'droste:droste' | chpasswd \
    && usermod -aG sudo droste \
    && mkdir -p /etc/systemd/network \
    && printf '[Match]\nName=en* eth*\n\n[Network]\nDHCP=yes\n' \
       > /etc/systemd/network/80-dhcp.network \
    && printf '[Match]\nKind=veth\n\n[Link]\nUnmanaged=yes\n' \
       > /etc/systemd/network/10-lxc-veth-unmanaged.network \
    && systemctl enable systemd-networkd \
    && systemctl enable serial-getty@ttyS0.service
