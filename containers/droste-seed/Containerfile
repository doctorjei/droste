FROM ghcr.io/doctorjei/tenkei/canopy:1.4.0

LABEL description="droste-seed: app base, FROM canopy + droste user"

# Canopy ships /usr/bin/ln, /usr/bin/cp, /usr/bin/chmod, etc. as symlinks to
# /usr/bin/busybox and registers dpkg-divert rules routing coreutils/iproute2/
# wget/etc. to `.distrib` paths so busybox can own the canonical names. Drostify
# needs GNU binaries (postinsts use busybox-incompatible flags: `ln -r`, `cp -Z`,
# `chmod --reference`, `mv -Z`). Remove the `.distrib` diversions so real
# packages install where dpkg postinst scripts expect them. Leaves `.usr-is-merged`
# and other non-busybox diversions alone.
RUN while IFS= read -r orig && IFS= read -r div && IFS= read -r owner; do \
        case "$div" in \
            *.distrib) dpkg-divert --quiet --no-rename --remove "$orig" || true ;; \
        esac; \
    done < /var/lib/dpkg/diversions

# Install coreutils + grep + sed + findutils + gzip in their own layer so
# their GNU binaries replace the busybox symlinks before any restore-list
# postinst runs. coreutils covers ln/cp/chmod/etc.; grep is needed because
# ucfr (from ucf, pulled in by openssh-server) uses `grep --count` which
# busybox rejects. sed/findutils/gzip preempt similar failures common in
# Debian postinst scripts.
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
       coreutils grep sed findutils gzip \
    && rm -rf /var/lib/apt/lists/*

COPY containers/droste-seed/canopy-restore.txt /tmp/canopy-restore.txt
RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
       $(grep -v '^#' /tmp/canopy-restore.txt | grep -v '^$') \
    && rm -f /tmp/canopy-restore.txt \
    && rm -rf /var/lib/apt/lists/*

# droste user (uid/gid 1000, NOPASSWD sudo)
RUN groupadd -g 1000 droste \
    && useradd -u 1000 -g droste -m -s /bin/bash droste \
    && printf 'droste ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/droste \
    && chmod 0440 /etc/sudoers.d/droste

# Sysctl (content preserves pre-migration build-seed.sh behavior: IP forwarding
# enabled so container/VM tiers can act as routers).
RUN printf 'net.ipv4.ip_forward = 1\nnet.ipv6.conf.all.forwarding = 1\n' \
    > /etc/sysctl.d/99-droste.conf

# Locales: uncomment the same 15 locale variants build-seed.sh enabled, run locale-gen.
RUN sed -i '/^# .*UTF-8/{ /en_US\|zh_CN\|zh_TW\|hi_IN\|es_ES\|ar_SA\|fr_FR\|bn_IN\|pt_BR\|pt_PT\|id_ID\|ur_PK\|de_DE\|ja_JP\|ko_KR/s/^# // }' /etc/locale.gen \
    && locale-gen

# No CMD — seed is init-less. Downstream tiers set their own.
