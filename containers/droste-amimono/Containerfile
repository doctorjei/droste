ARG BASE_IMAGE=droste-tapestry

FROM ghcr.io/doctorjei/tenkei/tenkei-kernel:1.4.1 AS tenkei-kernel

FROM ${BASE_IMAGE}

LABEL description="droste-amimono: VM-bootable tapestry (kento VM mode)"

COPY --from=tenkei-kernel /boot/vmlinuz /boot/vmlinuz
COPY --from=tenkei-kernel /boot/initramfs.img /boot/initramfs.img

# VM-only packages (not useful in system/LXC containers)
RUN apt-get update \
    && apt-get install -y -qq --no-install-recommends \
       qemu-guest-agent watchdog \
       qemu-system-x86 swtpm ovmf libvirt-daemon-system virtinst nbdkit \
       nfs-kernel-server cpu-checker irqbalance linux-cpupower \
       fence-agents numactl \
    && rm -rf /var/lib/apt/lists/*

# VM kernel module config
RUN printf 'options kvm_intel nested=1\noptions kvm_amd nested=1\n' \
       > /etc/modprobe.d/kvm-nested.conf \
    && printf 'nbd\ndrbd\n' > /etc/modules-load.d/droste.conf

# Unmask services that system tier masks for LXC (VMs need these)
RUN systemctl unmask systemd-growfs-root.service systemd-remount-fs.service

# VM boot fixes: set login password, enable DHCP + serial console
RUN echo 'droste:droste' | chpasswd \
    && usermod -aG sudo droste \
    && mkdir -p /etc/systemd/network \
    && printf '[Match]\nType=ether\n\n[Network]\nDHCP=yes\n' \
       > /etc/systemd/network/80-dhcp.network \
    && systemctl enable systemd-networkd \
    && systemctl enable serial-getty@ttyS0.service
