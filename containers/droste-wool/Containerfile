ARG BASE_IMAGE=droste-yarn

FROM ghcr.io/doctorjei/gemet/boot:1.6.2 AS gemet-boot

FROM ${BASE_IMAGE}

LABEL description="droste-wool: VM-bootable yarn (kento VM mode)"

COPY --from=gemet-boot /boot/vmlinuz /boot/vmlinuz
COPY --from=gemet-boot /boot/initramfs.img /boot/initramfs.img

# VM-only packages (not useful in system/LXC containers)
RUN apt-get update \
    && apt-get install -y -qq --no-install-recommends \
       qemu-guest-agent watchdog \
       qemu-system-x86 virtiofsd swtpm ovmf libvirt-daemon-system virtinst nbdkit \
       nfs-kernel-server cpu-checker irqbalance linux-cpupower \
    && rm -rf /var/lib/apt/lists/*

# VM kernel module config
RUN printf 'options kvm_intel nested=1\noptions kvm_amd nested=1\n' \
       > /etc/modprobe.d/kvm-nested.conf \
    && printf 'nbd\n' > /etc/modules-load.d/droste.conf

# VM boot fixes: set login password, enable DHCP + serial console
RUN echo 'droste:droste' | chpasswd \
    && usermod -aG sudo droste \
    && usermod -aG kvm droste \
    && mkdir -p /etc/systemd/network \
    && printf '[Match]\nType=ether\n\n[Network]\nDHCP=yes\n' \
       > /etc/systemd/network/80-dhcp.network \
    && systemctl enable systemd-networkd \
    && systemctl enable serial-getty@ttyS0.service
