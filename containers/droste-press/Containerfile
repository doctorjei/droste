ARG BASE_IMAGE=droste-tome
FROM ${BASE_IMAGE}

LABEL description="droste-press: C/C++ development toolchain (app counterpart of loom)"

USER root

RUN apt-get -qq update \
    && apt-get -qq install -y --no-install-recommends \
      build-essential cmake pkg-config \
      autoconf automake libtool \
      gdb valgrind \
      ccache ninja-build bear \
      bison flex \
      libelf-dev libssl-dev libncurses-dev \
      cpio busybox-static \
      shellcheck \
      python3-build \
      poppler-utils git-lfs \
      bat git-delta \
    && rm -rf /var/lib/apt/lists/*

# ── bat convenience symlink (Debian ships bat as batcat) ──
RUN ln -sf /usr/bin/batcat /usr/local/bin/bat

USER droste

# ── Make pipx-installed binaries discoverable in non-login shells ──
ENV PATH="/home/droste/.local/bin:${PATH}"

# ── Python dev toolchain (pipx) ──
RUN for pkg in black isort ruff mypy pre-commit twine bump-my-version; do pipx install "$pkg"; done
